# Copy to .env and fill in. Never commit the filled-in file.

# Supabase Postgres.
# Local dev can use either connection string; Render MUST use the Session
# pooler (aws-0-<region>.pooler.supabase.com) because the direct host
# db.<ref>.supabase.co is IPv6-only and Render cannot reach it.
# Percent-encode any @ in the password as %40.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Required by clerkMiddleware — every route sits behind it.
CLERK_SECRET_KEY=sk_test_...

# Optional. Render sets PORT itself; do not set it there.
PORT=5005
