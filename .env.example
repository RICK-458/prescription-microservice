# Copy to .env and fill in. Never commit the filled-in file.

# Supabase Postgres.
# Local dev can use either connection string; Render MUST use the Session
# pooler (aws-0-<region>.pooler.supabase.com) because the direct host
# db.<ref>.supabase.co is IPv6-only and Render cannot reach it.
# Percent-encode any @ inside the PASSWORD as %40. The @ that separates the
# password from the host stays literal — encoding that one instead is the
# usual mistake and makes the host unresolvable:
#   wrong: ...:pa55w0rd@99%40aws-0-<region>.pooler.supabase.com
#   right: ...:pa55w0rd%4099@aws-0-<region>.pooler.supabase.com
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# clerkMiddleware() requires BOTH keys. Missing the publishable key makes
# every request fail with 500 "Publishable key is missing".
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional. Render sets PORT itself; do not set it there.
PORT=5005
